# Perfetto config for record_trace.bat
# Same as the old short options (20s / 32mb / atrace sched,freq,view,ss,input / all apps)
# plus Frame Timeline (android.surfaceflinger.frametimeline).
#
# Used via: python record_android_trace -c record_trace.config -o trace_file.perfetto-trace

buffers: {
  size_kb: 32768
  fill_policy: RING_BUFFER
}

data_sources: {
  config {
    name: "linux.ftrace"
    ftrace_config {
      atrace_categories: "sched"
      atrace_categories: "freq"
      atrace_categories: "view"
      atrace_categories: "ss"
      atrace_categories: "input"
      atrace_apps: "*"
    }
  }
}

# Frame Timeline: expected/actual frames, jank_type, present_type (Android 12+)
data_sources: {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}

# Process/thread names (was auto-included by the short CLI path)
data_sources: {
  config {
    name: "linux.process_stats"
  }
}

duration_ms: 20000
